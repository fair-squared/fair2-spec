@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cr: <http://mlcommons.org/croissant/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

# FAIR2 Ontology — 2026-03-30T12:00:00.000000Z
# Includes only terms used in published datasets.

fair2:OpenDataArticle a rdfs:Class ;
  rdfs:label "OpenDataArticle" ;
  rdfs:comment "Scholarly work describing and linking an open dataset with methods and reuse guidance." ;
  rdfs:subClassOf schema:ScholarlyArticle .

fair2:MethodSection a rdfs:Class ;
  rdfs:label "MethodSection" ;
  rdfs:comment "Structured section grouping procedural steps for a method." ;
  rdfs:subClassOf schema:HowToSection .

fair2:Step a rdfs:Class ;
  rdfs:label "Step" ;
  rdfs:comment "Atomic procedural instruction within a method." ;
  rdfs:subClassOf schema:HowToStep .

fair2:Substep a rdfs:Class ;
  rdfs:label "Substep" ;
  rdfs:comment "Subordinate procedural instruction nested under a Step." ;
  rdfs:subClassOf schema:HowToStep .

fair2:RecordSet a rdfs:Class ;
  rdfs:label "RecordSet" ;
  rdfs:comment "A coherent subset of a dataset used for analysis or curation." ;
  rdfs:subClassOf schema:Dataset .

fair2:Visualization a rdfs:Class ;
  rdfs:label "Visualization" ;
  rdfs:comment "A visual artifact (plot, figure, dashboard) derived from the dataset." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:DescriptiveStatistics a rdfs:Class ;
  rdfs:label "DescriptiveStatistics" ;
  rdfs:comment "Summary statistics computed over a RecordSet or Dataset." ;
  rdfs:subClassOf schema:Dataset .

fair2:Submission a rdfs:Class ;
  rdfs:label "Submission" ;
  rdfs:comment "Reserved. Intended as a submission package grouping dataset, article and supporting materials for review; it has no shape or example, and whether it appears in a published fair2.json is not yet decided. Do not rely on it." ;
  rdfs:subClassOf schema:CreativeWork ;
  vs:term_status "unstable" .

fair2:DataPortal a rdfs:Class ;
  rdfs:label "DataPortal" ;
  rdfs:comment "An authored, versioned web application presenting a single FAIR² dataset - an interactive explorer or landing site, not a catalogue of many datasets and not a bare API endpoint. Hence the required author, version and keywords, and the optional changeLog." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:DataArchive a rdfs:Class ;
  rdfs:label "DataArchive" ;
  rdfs:comment "An archive component that stores and preserves datasets for long-term access." ;
  rdfs:subClassOf schema:ArchiveComponent .

fair2:activities a rdf:Property ;
  rdfs:label "activities" ;
  rdfs:comment "Reserved. Intended to group provenance activities for an entity, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:attachment a rdf:Property ;
  rdfs:label "attachment" ;
  rdfs:comment "Reserved. Intended to reference supplemental material in a submission package, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:builds a rdf:Property ;
  rdfs:label "builds" ;
  rdfs:comment "Reserved. Intended to record that one artifact extends another, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:contributorRole a rdf:Property ;
  rdfs:label "contributorRole" ;
  rdfs:comment "Links a contribution to a contributor role term." ;
  schema:domainIncludes schema:Role ;
  schema:rangeIncludes fair2:ContributorRole ;
  vs:term_status "stable" .

fair2:dataArticle a rdf:Property ;
  rdfs:label "dataArticle" ;
  rdfs:comment "Links a dataset or submission to its associated scholarly data article." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataArticle ;
  vs:term_status "stable" .

fair2:dataset a rdf:Property ;
  rdfs:label "dataset" ;
  rdfs:comment "References the dataset resource associated with the entity." ;
  schema:domainIncludes fair2:DataArchive, fair2:DataPortal ;
  schema:rangeIncludes schema:Dataset ;
  vs:term_status "stable" .

fair2:digest a rdf:Property ;
  rdfs:label "digest" ;
  rdfs:comment "Reserved. Intended to carry a short digest for quick identification, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:manuscript a rdf:Property ;
  rdfs:label "manuscript" ;
  rdfs:comment "Reserved. Intended to reference a manuscript file in a submission package, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:roleName a rdf:Property ;
  rdfs:label "roleName" ;
  rdfs:comment "Human-readable label for a contributor role." ;
  schema:domainIncludes fair2:Role ;
  schema:rangeIncludes schema:Text ;
  vs:term_status "stable" .

fair2:statistics a rdf:Property ;
  rdfs:label "statistics" ;
  rdfs:comment "Links to computed descriptive statistics." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes fair2:DescriptiveStatistics ;
  vs:term_status "stable" .

fair2:step a rdf:Property ;
  rdfs:label "step" ;
  rdfs:comment "Connects a MethodSection with its constituent Step items." ;
  schema:domainIncludes fair2:Section ;
  schema:rangeIncludes fair2:Step, fair2:StepCase ;
  vs:term_status "stable" .

fair2:store a rdf:Property ;
  rdfs:label "store" ;
  rdfs:comment "Reserved. Intended for the storage location or repository endpoint of an asset, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:variables a rdf:Property ;
  rdfs:label "variables" ;
  rdfs:comment "Lists variable or feature definitions referenced by an analysis or record set." ;
  schema:rangeIncludes schema:DefinedTermSet ;
  vs:term_status "stable" .

fair2:visualization a rdf:Property ;
  rdfs:label "visualization" ;
  rdfs:comment "Links to a visualization derived from the dataset or record set." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:Visualization ;
  vs:term_status "stable" .

fair2:dataPortal a rdf:Property ;
  rdfs:label "dataPortal" ;
  rdfs:comment "Links a dataset to an associated data portal." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataPortal ;
  vs:term_status "stable" .

fair2:dataArchive a rdf:Property ;
  rdfs:label "dataArchive" ;
  rdfs:comment "Links a dataset to an associated data archive." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataArchive ;
  vs:term_status "stable" .

fair2:generated a rdf:Property ;
  rdfs:label "generated" ;
  rdfs:comment "Links a method step to the RecordSet fields or artifacts it produced (lineage)." ;
  schema:domainIncludes fair2:Step ;
  schema:rangeIncludes cr:Field ;
  vs:term_status "stable" .

# ---------------------------------------------------------------------------
# Terms used by the SHACL shapes and the JSON-LD context that were previously
# undeclared here. Domain/range use schema:domainIncludes and
# schema:rangeIncludes (union semantics) rather than rdfs:domain/rdfs:range,
# whose multiple values are read as an intersection — wrong for properties
# such as fair2:next and fair2:changeLog, which apply to several classes.
# ---------------------------------------------------------------------------

## Classes

fair2:Section a rdfs:Class ;
  rdfs:label "Section" ;
  rdfs:comment "Structured methodology section grouping procedural steps. Target of fair2s:MethodSectionShape; fair2:MethodSection is a legacy alias." ;
  rdfs:subClassOf schema:HowToSection .

fair2:StepCase a rdfs:Class ;
  rdfs:label "StepCase" ;
  rdfs:comment "Conditional branch within a method, carrying the condition and the path taken when it holds. Sits in the same fair2:step list as a Step." ;
  rdfs:subClassOf schema:HowToStep .

fair2:Certification a rdfs:Class ;
  rdfs:label "Certification" ;
  rdfs:comment "Pointer node asserting the FAIR² certification or validation status of a package, and referencing the external credential." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:DataArticle a rdfs:Class ;
  rdfs:label "DataArticle" ;
  rdfs:comment "Scholarly article describing a dataset, its methods and its reuse." ;
  rdfs:subClassOf schema:ScholarlyArticle .

fair2:ExperimentDataset a rdfs:Class ;
  rdfs:label "ExperimentDataset" ;
  rdfs:comment "A dataset produced by an experiment, as distinct from an observational or derived one. Applied as an additional type alongside schema:Dataset." ;
  rdfs:subClassOf schema:Dataset .

fair2:OpenDataArticleSection a rdfs:Class ;
  rdfs:label "OpenDataArticleSection" ;
  rdfs:comment "A titled section of an open data article." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:Role a rdfs:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role played by an agent in relation to a dataset or article." ;
  rdfs:subClassOf schema:Role .

fair2:AuthorRole a rdfs:Class ;
  rdfs:label "AuthorRole" ;
  rdfs:comment "Role played by an author in producing the dataset (e.g. Corresponding Author)." ;
  rdfs:subClassOf fair2:Role .

fair2:ContributorRole a rdfs:Class ;
  rdfs:label "ContributorRole" ;
  rdfs:comment "Contributor role drawn from the CRediT or CRO vocabularies." ;
  rdfs:subClassOf fair2:Role .

fair2:Audience a rdfs:Class ;
  rdfs:label "Audience" ;
  rdfs:comment "Intended audience for a dataset or article." ;
  rdfs:subClassOf schema:Audience .

## Method properties

fair2:methodSection a rdf:Property ;
  rdfs:label "methodSection" ;
  rdfs:comment "Links a dataset to a methodology section." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:Section .

fair2:substep a rdf:Property ;
  rdfs:label "substep" ;
  rdfs:comment "Nests a subordinate procedural instruction under a Step." ;
  schema:domainIncludes fair2:Step ;
  schema:rangeIncludes fair2:Substep .

fair2:next a rdf:Property ;
  rdfs:label "next" ;
  rdfs:comment "References the following element in a method sequence, so order does not depend on array position." ;
  schema:domainIncludes fair2:Section, fair2:Step, fair2:Substep, fair2:StepCase ;
  schema:rangeIncludes fair2:Section, fair2:Step, fair2:Substep, fair2:StepCase .

fair2:nextTrue a rdf:Property ;
  rdfs:label "nextTrue" ;
  rdfs:comment "The path taken when a StepCase condition holds." ;
  schema:domainIncludes fair2:StepCase ;
  schema:rangeIncludes fair2:Step .

fair2:qualifiedUsage a rdf:Property ;
  rdfs:label "qualifiedUsage" ;
  rdfs:comment "The condition governing a StepCase, as a string expression." ;
  schema:domainIncludes fair2:StepCase ;
  schema:rangeIncludes schema:Text .

## Certification properties

fair2:certifiedBy a rdf:Property ;
  rdfs:label "certifiedBy" ;
  rdfs:comment "The organisation issuing the certification." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Organization .

fair2:dateIssued a rdf:Property ;
  rdfs:label "dateIssued" ;
  rdfs:comment "Date the certification was issued." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Date .

fair2:fair2ComplianceLevel a rdf:Property ;
  rdfs:label "fair2ComplianceLevel" ;
  rdfs:comment "The FAIR² compliance level asserted for the package." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

fair2:certificationDocument a rdf:Property ;
  rdfs:label "certificationDocument" ;
  rdfs:comment "Reference to the external credential document backing the certification." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

fair2:certificationScope a rdf:Property ;
  rdfs:label "certificationScope" ;
  rdfs:comment "What the certification covers (e.g. metadata-conformance, data-integrity)." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Text .

fair2:verificationEndpoint a rdf:Property ;
  rdfs:label "verificationEndpoint" ;
  rdfs:comment "Endpoint at which the certification can be verified." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

## Change-log properties

fair2:changeLog a rdf:Property ;
  rdfs:label "changeLog" ;
  rdfs:comment "Record of updates made to a dataset, article, archive or portal." ;
  schema:domainIncludes schema:Dataset, schema:ScholarlyArticle, fair2:DataArchive, fair2:DataPortal ;
  schema:rangeIncludes schema:UpdateAction .

fair2:newFeatures a rdf:Property ;
  rdfs:label "newFeatures" ;
  rdfs:comment "Additions introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:improvements a rdf:Property ;
  rdfs:label "improvements" ;
  rdfs:comment "Refinements introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:bugFixes a rdf:Property ;
  rdfs:label "bugFixes" ;
  rdfs:comment "Corrections introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:otherInformation a rdf:Property ;
  rdfs:label "otherInformation" ;
  rdfs:comment "Remaining notes for a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

## Dataset and field properties

fair2:domain a rdf:Property ;
  rdfs:label "domain" ;
  rdfs:comment "Subject domain classifying the dataset." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Thing .

fair2:citationKey a rdf:Property ;
  rdfs:label "citationKey" ;
  rdfs:comment "Short citation key for the dataset (e.g. a BibTeX key)." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Text .

fair2:isExperimentRelated a rdf:Property ;
  rdfs:label "isExperimentRelated" ;
  rdfs:comment "Whether a field records an experimental observation rather than descriptive metadata." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes schema:Boolean .

fair2:unit a rdf:Property ;
  rdfs:label "unit" ;
  rdfs:comment "Unit of measurement for a field, referenced by its QUDT IRI." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes qudt:Unit .

fair2:variable a rdf:Property ;
  rdfs:label "variable" ;
  rdfs:comment "A variable or feature definition referenced by an analysis or record set. Singular form of fair2:variables." ;
  schema:rangeIncludes schema:DefinedTerm .

fair2:validationReport a rdf:Property ;
  rdfs:label "validationReport" ;
  rdfs:comment "The validation report backing a certification or validation claim." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL ;
  vs:term_status "stable" .

fair2:fundingScheme a rdf:Property ;
  rdfs:label "fundingScheme" ;
  rdfs:comment "The funding programme a grant was awarded under. schema.org defines FundingScheme as a class but has no property of that name." ;
  schema:domainIncludes schema:Grant ;
  schema:rangeIncludes schema:FundingScheme ;
  vs:term_status "stable" .
