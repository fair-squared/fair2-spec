@prefix : <https://fair2.ai/ns/> .
@prefix schema: <https://schema.org/> .
@prefix cr: <https://mlcommons.org/croissant#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Dataset a rdfs:Class ;
    rdfs:subClassOf schema:Dataset ;
    rdfs:label "FAIR-Squared Dataset" ;
    rdfs:comment "A dataset that adheres to the FAIR2 principles, integrating context-rich metadata, AI-readiness, and responsible AI alignment." .

:hasMetadata a rdf:Property ;
    rdfs:label "Has Metadata" ;
    rdfs:comment "Links a dataset to its metadata." ;
    rdfs:domain :Dataset ;
    rdfs:range :Metadata .

:hasProvenance a rdf:Property ;
    rdfs:label "Has Provenance" ;
    rdfs:comment "Links metadata to provenance details." ;
    rdfs:domain :Metadata ;
    rdfs:range :Provenance .

:isAIReady a rdf:Property ;
    rdfs:label "Is AI Ready" ;
    rdfs:comment "Indicates AI compatibility of a dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range :AIReadiness .

:hasBiasAssessment a rdf:Property ;
    rdfs:label "Has Bias Assessment" ;
    rdfs:comment "Links a dataset to its bias assessment report." ;
    rdfs:domain :Dataset ;
    rdfs:range :ResponsibleAI .

:Method a rdfs:Class ;
    rdfs:label "FAIR2 Method" ;
    rdfs:comment "A method used to generate, process, or analyze a dataset." .

:Step a rdfs:Class ;
    rdfs:label "FAIR2 Step" ;
    rdfs:comment "A step within a method that describes a specific action in the dataset generation process." .

:hasMethod a rdf:Property ;
    rdfs:label "Has Method" ;
    rdfs:comment "Links a dataset to the methods used in its creation." ;
    rdfs:domain :Dataset ;
    rdfs:range :Method .

:step a rdf:Property ;
    rdfs:label "Step" ;
    rdfs:comment "Links a method to the steps it includes." ;
    rdfs:domain :Method ;
    rdfs:range :Step .

schema:name a rdf:Property ;
    rdfs:label "Name" ;
    rdfs:comment "The name of an entity, such as a method or step." ;
    rdfs:range xsd:string .

schema:description a rdf:Property ;
    rdfs:label "Description" ;
    rdfs:comment "A textual description of an entity." ;
    rdfs:domain :Step ;
    rdfs:range xsd:string .

schema:nextItem a rdf:Property ;
    rdfs:label "Next Item" ;
    rdfs:comment "Indicates the next step in a sequence." ;
    rdfs:domain :Step ;
    rdfs:range :Step .

:substep a rdf:Property ;
    rdfs:label "Substep" ;
    rdfs:comment "Defines a substep within a larger step." ;
    rdfs:domain :Step ;
    rdfs:range :Step .

:method a rdf:Property ;
    rdfs:label "Method" ;
    rdfs:comment "Describes the methods used to generate the dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range :Method .

cr:isLiveDataset a rdf:Property ;
    rdfs:label "Is Live Dataset" ;
    rdfs:comment "Indicates whether the dataset is live." ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:boolean .

rai:ethicsReview a rdf:Property ;
    rdfs:label "Ethics Review" ;
    rdfs:comment "Information about the ethics review process for the dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range rai:EthicsReview .

rai:EthicsReview a rdfs:Class ;
    rdfs:label "Ethics Review" ;
    rdfs:comment "Details about ethical review processes for the dataset." .

rai:reviewedBy a rdf:Property ;
    rdfs:label "Reviewed By" ;
    rdfs:comment "The entity that reviewed the dataset for ethical considerations." ;
    rdfs:domain rai:EthicsReview ;
    rdfs:range xsd:string .

rai:approvalStatus a rdf:Property ;
    rdfs:label "Approval Status" ;
    rdfs:comment "The approval status of the ethics review." ;
    rdfs:domain rai:EthicsReview ;
    rdfs:range xsd:string .

rai:reviewDate a rdf:Property ;
    rdfs:label "Review Date" ;
    rdfs:comment "The date on which the ethics review was conducted." ;
    rdfs:domain rai:EthicsReview ;
    rdfs:range xsd:date .

rai:dataBiases a rdf:Property ;
    rdfs:label "Data Biases" ;
    rdfs:comment "Information about any known biases in the dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string .

rai:dataLimitations a rdf:Property ;
    rdfs:label "Data Limitations" ;
    rdfs:comment "Information about any limitations of the dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string .

cr:citeAs a rdf:Property ;
    rdfs:label "Cite As" ;
    rdfs:comment "The preferred way to cite this dataset." ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string .