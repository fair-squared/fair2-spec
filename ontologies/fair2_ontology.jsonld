      },
      "schema:rangeIncludes": [
        {
          "@id": "fair2:Step"
        },
        {
          "@id": "fair2:StepCase"
        }
      ],
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:store",
      "@type": "rdf:Property",
      "rdfs:comment": "Reserved. Intended for the storage location or repository endpoint of an asset, but no domain, range, shape or example is specified yet; do not rely on it.",
      "rdfs:label": "store",
      "vs:term_status": "unstable"
    },
    {
      "@id": "fair2:substep",
      "@type": "rdf:Property",
      "rdfs:comment": "Nests a subordinate procedural instruction under a Step.",
      "rdfs:label": "substep",
      "schema:domainIncludes": {
        "@id": "fair2:Step"
      },
      "schema:rangeIncludes": {
        "@id": "fair2:Substep"
      }
    },
    {
      "@id": "fair2:unit",
      "@type": "rdf:Property",
