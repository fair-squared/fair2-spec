      "rdfs:label": "unit",
      "schema:domainIncludes": {
        "@id": "cr:Field"
      },
      "schema:rangeIncludes": {
        "@id": "qudt:Unit"
      }
    },
    {
      "@id": "fair2:validationReport",
      "@type": "rdf:Property",
      "rdfs:comment": "The validation report backing a certification or validation claim.",
      "rdfs:label": "validationReport",
