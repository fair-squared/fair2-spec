      "@id": "fair2:role",
      "@type": "rdf:Property",
      "rdfs:comment": "The role a field plays in its record set: identifier, dimension, measure, count, category, datetime, geo or filemeta. identifier corresponds to cr:key on the record set; dimension, measure and the attribute-like roles to the RDF Data Cube component properties qb:DimensionProperty, qb:MeasureProperty and qb:AttributeProperty.",
      "rdfs:label": "role",
      "schema:domainIncludes": {
        "@id": "cr:Field"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:roleSource",
      "@type": "rdf:Property",
      "rdfs:comment": "Whether a field's role was asserted by a curator or computed from the data: asserted or computed.",
      "rdfs:label": "roleSource",
      "schema:domainIncludes": [
        {
          "@id": "cr:Field"
        },
        {
          "@id": "schema:PropertyValue"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:rowCount",
      "@type": "rdf:Property",
      "rdfs:comment": "The number of rows in a table.",
      "rdfs:label": "rowCount",
      "schema:domainIncludes": [
        {
          "@id": "cr:FileObject"
        },
        {
          "@id": "cr:RecordSet"
        },
        {
          "@id": "prov:Derivation"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "xsd:nonNegativeInteger"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:severity",
      "@type": "rdf:Property",
      "rdfs:comment": "How severe an issue is, on the oa:Annotation that records it.",
      "rdfs:label": "severity",
      "schema:domainIncludes": {
        "@id": "oa:Annotation"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:sourceDistinct",
      "@type": "rdf:Property",
      "rdfs:comment": "Distinct values, or value tuples, on the side an inferred join starts from.",
      "rdfs:label": "sourceDistinct",
      "schema:domainIncludes": [
        {
          "@id": "fair2:CompositeKey"
        },
        {
          "@id": "fair2:InferredJoin"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "xsd:nonNegativeInteger"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:statistics",
      "@type": "rdf:Property",
      "rdfs:comment": "Deprecated. Linked a field to computed descriptive statistics; superseded from v1.5.0 by cr:annotation, which attaches each statistic as a cr:Field carrying a value. Retained only so existing references resolve.",
      "rdfs:label": "statistics",
      "schema:domainIncludes": {
        "@id": "cr:Field"
      },
      "schema:rangeIncludes": {
        "@id": "fair2:DescriptiveStatistics"
      },
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:step",
      "@type": "rdf:Property",
      "rdfs:comment": "Connects a MethodSection with its constituent Step items.",
      "rdfs:label": "step",
      "schema:domainIncludes": {
        "@id": "fair2:Section"
      },
      "schema:rangeIncludes": [
        {
          "@id": "fair2:Step"
        },
        {
          "@id": "fair2:StepCase"
        }
      ],
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:store",
      "@type": "rdf:Property",
      "rdfs:comment": "Reserved. Intended for the storage location or repository endpoint of an asset, but no domain, range, shape or example is specified yet; do not rely on it.",
      "rdfs:label": "store",
      "vs:term_status": "unstable"
    },
    {
      "@id": "fair2:subjectType",
      "@type": "rdf:Property",
      "rdfs:comment": "Who or what the data is about, as assessed by a privacy screening (e.g. human participants).",
      "rdfs:label": "subjectType",
      "schema:domainIncludes": {
        "@id": "fair2:PrivacyScreening"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:substep",
      "@type": "rdf:Property",
      "rdfs:comment": "Nests a subordinate procedural instruction under a Step.",
      "rdfs:label": "substep",
      "schema:domainIncludes": {
        "@id": "fair2:Step"
      },
      "schema:rangeIncludes": {
        "@id": "fair2:Substep"
      }
    },
    {
      "@id": "fair2:targetDistinct",
      "@type": "rdf:Property",
      "rdfs:comment": "Distinct values, or value tuples, on the side an inferred join ends at.",
      "rdfs:label": "targetDistinct",
      "schema:domainIncludes": [
        {
          "@id": "fair2:CompositeKey"
        },
        {
          "@id": "fair2:InferredJoin"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "xsd:nonNegativeInteger"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:temporalGovernance",
      "@type": "rdf:Property",
      "rdfs:comment": "Phases in which the access tier or environment changes over time, as a JSON object.",
      "rdfs:label": "temporalGovernance",
      "schema:domainIncludes": {
        "@id": "schema:Dataset"
      },
      "schema:rangeIncludes": {
        "@id": "rdf:JSON"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:toField",
      "@type": "rdf:Property",
      "rdfs:comment": "The field or fields an inferred join or composite key ends at.",
      "rdfs:label": "toField",
      "schema:domainIncludes": [
        {
          "@id": "fair2:CompositeKey"
        },
        {
          "@id": "fair2:InferredJoin"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "cr:Field"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:uniqueness",
      "@type": "rdf:Property",
      "rdfs:comment": "How unique the joined key is on the side it ends at, from 0 to 1.",
      "rdfs:label": "uniqueness",
      "schema:domainIncludes": {
        "@id": "fair2:InferredJoin"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:decimal"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:unit",
      "@type": "rdf:Property",
      "rdfs:comment": "Unit of measurement for a field, referenced by its QUDT IRI.",
      "rdfs:label": "unit",
      "schema:domainIncludes": {
        "@id": "cr:Field"
      },
      "schema:rangeIncludes": {
        "@id": "qudt:Unit"
      }
    },
    {
      "@id": "fair2:unitLabelSource",
      "@type": "rdf:Property",
      "rdfs:comment": "Where the record-unit labels came from: a curated catalog or the producing agent.",
      "rdfs:label": "unitLabelSource",
      "schema:domainIncludes": {
        "@id": "cr:RecordSet"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:unitPlural",
      "@type": "rdf:Property",
      "rdfs:comment": "The plural of fair2:unitSingular (e.g. cells, patients).",
      "rdfs:label": "unitPlural",
      "schema:domainIncludes": {
        "@id": "cr:RecordSet"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:unitSingular",
      "@type": "rdf:Property",
      "rdfs:comment": "What one record of the record set is, in the singular (e.g. cell, patient).",
      "rdfs:label": "unitSingular",
      "schema:domainIncludes": {
        "@id": "cr:RecordSet"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:userOverride",
      "@type": "rdf:Property",
      "rdfs:comment": "Whether the person running the screening overrode its decision.",
      "rdfs:label": "userOverride",
      "schema:domainIncludes": {
        "@id": "fair2:PrivacyScreening"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:boolean"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:validationReport",
      "@type": "rdf:Property",
      "rdfs:comment": "The validation report backing a certification or validation claim.",
      "rdfs:label": "validationReport",
      "schema:domainIncludes": {
        "@id": "fair2:Certification"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:valueConstraints",
      "@type": "rdf:Property",
      "rdfs:comment": "The values a field may take or the range it must fall in, in words. Distinct from fair2:constraints, a dataset's use constraints.",
      "rdfs:label": "valueConstraints",
      "schema:domainIncludes": {
        "@id": "cr:Field"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:variableGovernance",
      "@type": "rdf:Property",
      "rdfs:comment": "Access tiers and rules for individual columns, files, asset classes and record partitions, as a JSON object.",
      "rdfs:label": "variableGovernance",
      "schema:domainIncludes": {
        "@id": "schema:Dataset"
      },
      "schema:rangeIncludes": {
        "@id": "rdf:JSON"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:verificationEndpoint",
      "@type": "rdf:Property",
      "rdfs:comment": "Endpoint at which the certification can be verified.",
      "rdfs:label": "verificationEndpoint",
      "schema:domainIncludes": {
        "@id": "fair2:Certification"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    }
  ]
}
