{
  "@context": {
    "cr": "http://mlcommons.org/croissant/",
    "dct": "http://purl.org/dc/terms/",
    "ddi-stats": "http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/",
    "fair2": "https://fair2.ai/ns/",
    "oa": "http://www.w3.org/ns/oa#",
    "prov": "http://www.w3.org/ns/prov#",
    "qudt": "http://qudt.org/schema/qudt/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "vs": "http://www.w3.org/2003/06/sw-vocab-status/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "fair2:AccessTier",
      "@type": "rdfs:Class",
      "rdfs:comment": "An access tier of the FAIR² governance model: L0 (open), L1 (registered) or L2 (credentialed). Named by accessRights; fair2:access states it as a JSON field.",
      "rdfs:label": "AccessTier",
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:AgreementLevel0",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L1"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 0 — Embargoed",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel1",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L0"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 1 — Open",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel2",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L0"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 2 — Collaborative",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel3",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 3 — Trusted",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel4",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L1"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 4 — Community-governed",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel5",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 5 — Secure environment",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevel6",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 6 — Federated compute-to-data",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels0",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L1"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 0 — Embargoed",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels1",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L0"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 1 — Open",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels2",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L0"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 2 — Collaborative",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels3",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 3 — Trusted",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels4",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L1"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 4 — Community-governed",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels5",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 5 — Secure environment",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AgreementLevels6",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "fair2:L2"
      },
      "rdfs:comment": "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve.",
      "rdfs:label": "Agreement Level 6 — Federated compute-to-data",
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:AuthorRole",
      "@type": "rdfs:Class",
      "rdfs:comment": "Role played by an author in producing the dataset (e.g. Corresponding Author).",
      "rdfs:label": "AuthorRole",
      "rdfs:subClassOf": {
        "@id": "schema:Role"
      }
    },
    {
      "@id": "fair2:Certification",
      "@type": "rdfs:Class",
      "rdfs:comment": "Pointer node asserting the FAIR² certification or validation status of a package, and referencing the external credential.",
      "rdfs:label": "Certification",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "fair2:CertificationScope",
      "@type": "rdfs:Class",
      "rdfs:comment": "A facet of a package that a certification covers.",
      "rdfs:label": "CertificationScope",
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:Certified",
      "@type": "fair2:ComplianceLevel",
      "rdfs:comment": "An authority assertion, backed by a credential signed by an authorised certifier. There is no metadata-only variant: fair2:certificationScope records what was checked.",
      "rdfs:label": "FAIR²-Certified",
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:ComplianceLevel",
      "@type": "rdfs:Class",
      "rdfs:comment": "A FAIR² compliance status asserted for a package.",
      "rdfs:label": "ComplianceLevel",
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:CompositeKey",
      "@type": "rdfs:Class",
      "rdfs:comment": "A verified foreign key over several fields, for when Croissant cannot state it. Croissant writes one as a cr:references on each source field into the target record set's cr:key; a record set has one key, so when the target's key is another set of fields the composite is stated with this instead. Its tuple is unique on the target, and the source's tuples fall inside it.",
      "rdfs:label": "CompositeKey",
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:ContributorRole",
      "@type": "rdfs:Class",
      "rdfs:comment": "Contributor role drawn from the CRediT or CRO vocabularies.",
      "rdfs:label": "ContributorRole",
      "rdfs:subClassOf": {
        "@id": "schema:Role"
      }
    },
    {
      "@id": "fair2:DataArchive",
      "@type": "rdfs:Class",
      "rdfs:comment": "An archive component that stores and preserves datasets for long-term access.",
      "rdfs:label": "DataArchive",
      "rdfs:subClassOf": {
        "@id": "schema:ArchiveComponent"
      }
    },
    {
      "@id": "fair2:DataArticle",
      "@type": "rdfs:Class",
      "rdfs:comment": "Scholarly article describing a dataset, its methods and its reuse.",
      "rdfs:label": "DataArticle",
      "rdfs:subClassOf": {
        "@id": "schema:ScholarlyArticle"
      }
    },
    {
      "@id": "fair2:DataIntegrity",
      "@type": "fair2:CertificationScope",
      "rdfs:comment": "The data files were retrieved and checked against their recorded digests. A certification whose scope omits this token must be rendered as \"FAIR²-Certified (metadata only)\".",
      "rdfs:label": "dataIntegrity"
    },
    {
      "@id": "fair2:DataPortal",
      "@type": "rdfs:Class",
      "rdfs:comment": "An authored, versioned web application presenting a single FAIR² dataset - an interactive explorer or landing site, not a catalogue of many datasets and not a bare API endpoint. Hence the required author, version and keywords, and the optional changeLog.",
      "rdfs:label": "DataPortal",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "fair2:DescriptiveStatistics",
      "@type": "rdfs:Class",
      "rdfs:comment": "Deprecated. Croissant 1.1 models statistics with cr:annotation, attaching a cr:Field that carries a value rather than a source; FAIR2 documents use that from v1.5.0. This class described the wrapper the superseded fair2:statistics property pointed at, and is retained only so existing references resolve.",
      "rdfs:label": "DescriptiveStatistics",
      "rdfs:subClassOf": {
        "@id": "schema:StructuredValue"
      },
      "vs:term_status": "deprecated"
    },
    {
      "@id": "fair2:DistinctValueCount",
      "@type": "fair2:SummaryStatistic",
      "rdfs:comment": "Number of distinct values in the field. DDI-CDI SummaryStatisticType has no equivalent; its c646dd8 is Valid cases, the count of non-missing values.",
      "rdfs:label": "unique"
    },
    {
      "@id": "fair2:ExpectedValueCount",
      "@type": "fair2:SummaryStatistic",
      "rdfs:comment": "How many values the extraction expected to find, against which count and missing_values are read. Describes completeness of the extraction rather than a distribution, so it is deliberately FAIR2-local.",
      "rdfs:label": "expected_number_of_values"
    },
    {
      "@id": "fair2:FAIR2CertificationCredential",
      "@type": "rdfs:Class",
      "rdfs:comment": "A W3C Verifiable Credential asserting the FAIR² certification status of one exact package version. Published as fair2-cert.json and referenced by fair2:certificationDocument.",
      "rdfs:label": "FAIR2CertificationCredential",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:FAIR2CertifierRegistry",
      "@type": "rdfs:Class",
      "rdfs:comment": "The signed list of entities authorised to issue FAIR² certifications, published by the governance body.",
      "rdfs:label": "FAIR2CertifierRegistry",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:FrequencyDistribution",
      "@type": "fair2:SummaryStatistic",
      "rdfs:comment": "Frequency of the most common values, as a JSON object mapping label to count. Carried as an rdf:JSON literal, the same mechanism Croissant uses for cr:data and cr:examples.",
      "rdfs:label": "top_10_freq"
    },
    {
      "@id": "fair2:InferredJoin",
      "@type": "rdfs:Class",
      "rdfs:comment": "A join between record sets found by inference and not verified. Unlike cr:references, which declares a verified foreign key, it records the evidence and how far it holds. One or more fields on each side.",
      "rdfs:label": "InferredJoin",
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:IntegrityAssessment",
      "@type": "rdfs:Class",
      "rdfs:comment": "An assessment of a dataset's internal consistency and completeness. The issues it finds are oa:Annotations motivated by oa:assessing.",
      "rdfs:label": "IntegrityAssessment",
      "rdfs:subClassOf": {
        "@id": "prov:Activity"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:L0",
      "@type": "fair2:AccessTier",
      "rdfs:comment": "No authentication. Data is distributed unencrypted; the governance terms state licence and use conditions but do not gate access.",
      "rdfs:label": "L0 — Open",
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:L1",
      "@type": "fair2:AccessTier",
      "rdfs:comment": "An authenticated identity and acceptance of the terms.",
      "rdfs:label": "L1 — Registered",
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:L2",
      "@type": "fair2:AccessTier",
      "rdfs:comment": "The dataset's credential requirements - by default a signed data use agreement.",
      "rdfs:label": "L2 — Credentialed",
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:LicenseVerification",
      "@type": "fair2:CertificationScope",
      "rdfs:comment": "The declared licence was checked for presence and internal consistency.",
      "rdfs:label": "licenseVerification"
    },
    {
      "@id": "fair2:MetadataConformance",
      "@type": "fair2:CertificationScope",
      "rdfs:comment": "The metadata conforms to the declared FAIR² profile.",
      "rdfs:label": "metadataConformance"
    },
    {
      "@id": "fair2:MethodSection",
      "@type": "rdfs:Class",
      "rdfs:comment": "Legacy alias for fair2:Section, retained so existing documents keep resolving. Declared a subclass of fair2:Section rather than of schema:HowToSection directly, so that fair2s:MethodSectionShape reaches legacy nodes too; fair2:Section supplies the schema:HowToSection parent.",
      "rdfs:label": "MethodSection",
      "rdfs:subClassOf": {
        "@id": "fair2:Section"
      }
    },
    {
      "@id": "fair2:ModalFrequency",
      "@type": "fair2:SummaryStatistic",
      "rdfs:comment": "How often the modal value occurs. Pairs with the mode itself, which is ddi-stats:650be61; DDI names the mode but not its frequency.",
      "rdfs:label": "freq",
      "skos:related": {
        "@id": "ddi-stats:650be61"
      }
    },
    {
      "@id": "fair2:PrivacyScreening",
      "@type": "rdfs:Class",
      "rdfs:comment": "An assessment of whether, and how, a dataset can be published without disclosing personal information.",
      "rdfs:label": "PrivacyScreening",
      "rdfs:subClassOf": {
        "@id": "prov:Activity"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:ProcessAttestation",
      "@type": "fair2:CertificationScope",
      "rdfs:comment": "The production process was attested by the certifier.",
      "rdfs:label": "processAttestation"
    },
    {
      "@id": "fair2:Section",
      "@type": "rdfs:Class",
      "rdfs:comment": "Structured methodology section grouping procedural steps. Target of fair2s:MethodSectionShape; fair2:MethodSection is a legacy alias.",
      "rdfs:label": "Section",
      "rdfs:subClassOf": {
        "@id": "schema:HowToSection"
      }
    },
    {
      "@id": "fair2:Step",
      "@type": "rdfs:Class",
      "rdfs:comment": "Atomic procedural instruction within a method.",
      "rdfs:label": "Step",
      "rdfs:subClassOf": {
        "@id": "schema:HowToStep"
      }
    },
    {
      "@id": "fair2:StepCase",
      "@type": "rdfs:Class",
      "rdfs:comment": "Conditional branch within a method, carrying the condition and the path taken when it holds. Sits in the same fair2:step list as a Step.",
      "rdfs:label": "StepCase",
      "rdfs:subClassOf": {
        "@id": "schema:HowToStep"
      }
    },
    {
      "@id": "fair2:Submission",
      "@type": "rdfs:Class",
      "rdfs:comment": "Reserved. Intended as a submission package grouping dataset, article and supporting materials for review; it has no shape or example, and whether it appears in a published fair2.json is not yet decided. Do not rely on it.",
      "rdfs:label": "Submission",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "vs:term_status": "unstable"
    },
    {
      "@id": "fair2:Substep",
      "@type": "rdfs:Class",
      "rdfs:comment": "Subordinate procedural instruction nested under a Step.",
      "rdfs:label": "Substep",
      "rdfs:subClassOf": {
        "@id": "schema:HowToStep"
      }
    },
    {
      "@id": "fair2:SummaryStatistic",
      "@type": "rdfs:Class",
      "rdfs:comment": "A kind of descriptive statistic, named in cr:dataType on a cr:annotation. FAIR2 uses DDI-CDI SummaryStatisticType where it has a term; these three cover statistics it does not.",
      "rdfs:label": "SummaryStatistic",
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:TemporalProof",
      "@type": "fair2:CertificationScope",
      "rdfs:comment": "An RFC 3161 timestamp or blockchain anchor is attached to the certification.",
      "rdfs:label": "temporalProof"
    },
    {
      "@id": "fair2:Validated",
      "@type": "fair2:ComplianceLevel",
      "rdfs:comment": "A quality status asserting that the automated conformance checks pass. Self-assertable, provided the claim carries its evidence: the profile validated against, the validation run and its software agent, and the report.",
      "rdfs:label": "FAIR²-Validated",
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:access",
      "@type": "rdf:Property",
      "rdfs:comment": "The dataset's access tier and the conditions on access (the +G, +S, +C, +P, +J and +Q modifiers), as a JSON object. When absent, or without a tier, the dataset is L0 (open).",
      "rdfs:label": "access",
      "schema:domainIncludes": {
        "@id": "schema:Dataset"
      },
      "schema:rangeIncludes": {
        "@id": "rdf:JSON"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:action",
      "@type": "rdf:Property",
      "rdfs:comment": "The change a privacy screening requires of a field (e.g. drop, generalise, hash), on the oa:Annotation, motivated by oa:editing, that targets it.",
      "rdfs:label": "action",
      "schema:domainIncludes": {
        "@id": "oa:Annotation"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:agentGovernance",
      "@type": "rdf:Property",
      "rdfs:comment": "Whether and how AI agents acting for a person may use the dataset, as a JSON object.",
      "rdfs:label": "agentGovernance",
      "schema:domainIncludes": {
        "@id": "schema:Dataset"
      },
      "schema:rangeIncludes": {
        "@id": "rdf:JSON"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:allowedScopes",
      "@type": "rdf:Property",
      "rdfs:comment": "The certification scopes a certifier is authorised to assert. A credential declaring a scope outside this set does not verify.",
      "rdfs:label": "allowedScopes",
      "schema:domainIncludes": {
        "@id": "fair2:FAIR2CertifierRegistry"
      },
      "schema:rangeIncludes": {
        "@id": "fair2:CertificationScope"
      },
      "vs:term_status": "stable"
    },
    {
      "@id": "fair2:attachment",
      "@type": "rdf:Property",
      "rdfs:comment": "Reserved. Intended to reference supplemental material in a submission package, but no domain, range, shape or example is specified yet; do not rely on it.",
      "rdfs:label": "attachment",
      "vs:term_status": "unstable"
    },
    {
      "@id": "fair2:bugFixes",
      "@type": "rdf:Property",
      "rdfs:comment": "Corrections introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it.",
      "rdfs:label": "bugFixes",
      "schema:domainIncludes": {
        "@id": "schema:UpdateAction"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "fair2:cardinality",
      "@type": "rdf:Property",
      "rdfs:comment": "The cardinality of an inferred join: one-to-one, one-to-many, many-to-one or many-to-many.",
      "rdfs:label": "cardinality",
      "schema:domainIncludes": {
        "@id": "fair2:InferredJoin"
      },
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "vs:term_status": "testing"
    },
    {
      "@id": "fair2:certificationDocument",
      "@type": "rdf:Property",
      "rdfs:comment": "Reference to the external credential document backing the certification.",
      "rdfs:label": "certificationDocument",
      "schema:domainIncludes": {
        "@id": "fair2:Certification"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "fair2:certificationScope",
      "@type": "rdf:Property",
