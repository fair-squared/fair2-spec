{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "schema": "https://schema.org/",
    "fair2": "https://fair2.ai/ns/",
    "fair2s": "https://fair2.ai/shapes/"
  },
  "@graph": [
    {
      "@id": "fair2s:MethodShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "fair2:MethodSection",
      "sh:property": [
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "Each MethodSection must include a section name."
        },
        {
          "sh:path": "schema:description",
          "sh:datatype": "xsd:string",
          "sh:message": "Each MethodSection may include a description summarizing the methodological context."
        },
        {
          "sh:path": "fair2:step",
          "sh:node": { "@id": "fair2s:StepShape" },
          "sh:minCount": 1,
          "sh:message": "Each MethodSection must contain at least one Step."
        }
      ]
    },
    {
      "@id": "fair2s:StepShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "fair2:Step",
      "sh:property": [
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "Each Step must include a name."
        },
        {
          "sh:path": "schema:description",
          "sh:datatype": "xsd:string",
          "sh:message": "Each Step may include a description detailing actions or parameters."
        },
        {
          "sh:path": "fair2:substep",
          "sh:node": { "@id": "fair2s:SubStepShape" },
          "sh:message": "Substeps may be defined as nested procedural components."
        },
        {
          "sh:path": "fair2:next",
          "sh:nodeKind": "sh:IRI",
          "sh:message": "If provided, 'next' should reference the following step using an IRI."
        },
        {
          "sh:path": "fair2:generated",
          "sh:nodeKind": "sh:IRI",
          "sh:message": "If provided, 'generated' should reference produced data elements (e.g., fields, recordSets)."
        }
      ]
    },
    {
      "@id": "fair2s:SubStepShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "fair2:Substep",
      "sh:property": [
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "Each Substep must include a name."
        },
        {
          "sh:path": "schema:description",
          "sh:datatype": "xsd:string",
          "sh:message": "Each Substep may include a descriptive text."
        },
        {
          "sh:path": "fair2:next",
          "sh:nodeKind": "sh:IRI",
          "sh:message": "If provided, 'next' should reference the subsequent substep."
        }
      ]
    }
  ]
}