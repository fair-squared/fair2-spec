{
    "@context": {
        "sh": "http://www.w3.org/ns/shacl#",
        "schema": "https://schema.org/",
        "fair2": "https://fair2.ai/ns/",
        "fair2s": "https://fair2.ai/shapes/",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "sh:path": {
            "@type": "@id"
        },
        "sh:node": {
            "@type": "@id"
        },
        "sh:targetClass": {
            "@type": "@id"
        },
        "sh:nodeKind": {
            "@type": "@id"
        },
        "sh:datatype": {
            "@type": "@id"
        },
        "dct": "http://purl.org/dc/terms/",
        "prov": "http://www.w3.org/ns/prov#"
    },
    "_note": "DRAFT — pending governance decisions A, B, C. See docs/specification/certification.md.",
    "@id": "fair2s:CertificationShape",
    "@type": "sh:NodeShape",
    "sh:targetClass": "fair2:Certification",
    "sh:property": [
        {
            "sh:path": "fair2:certifiedBy",
            "sh:minCount": 1,
            "sh:node": "fair2s:OrganizationShape"
        },
        {
            "sh:path": "fair2:dateIssued",
            "sh:minCount": 1,
            "sh:datatype": "xsd:date"
        },
        {
            "sh:path": "fair2:fair2ComplianceLevel",
            "sh:minCount": 1,
            "sh:node": "fair2s:IdentifierShape"
        },
        {
            "sh:path": "fair2:certificationDocument",
            "sh:minCount": 1,
            "sh:node": "fair2s:IdentifierShape"
        },
        {
            "sh:path": "fair2:verificationEndpoint",
            "sh:nodeKind": "sh:IRI"
        },
        {
            "sh:path": "fair2:certificationScope",
            "sh:minCount": 1,
            "sh:node": "fair2s:TextShape"
        },
        {
            "sh:path": "dct:conformsTo",
            "sh:description": "The FAIR2 spec or profile version validated against, as a resolvable https://fair2.ai/spec/vX.Y.Z URI. Carried as a plain string, matching how Croissant conformance is declared on the Dataset.",
            "sh:node": "fair2s:IdentifierShape"
        },
        {
            "sh:path": "prov:wasGeneratedBy",
            "sh:node": "fair2s:ActivityShape",
            "sh:description": "The validation run, carrying the validator as a prov:SoftwareAgent with its version - the same pattern used for descriptive statistics."
        },
        {
            "sh:path": "fair2:validationReport",
            "sh:node": "fair2s:IdentifierShape",
            "sh:description": "The validation report backing the claim."
        }
    ]
}
