{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "fair2s": "https://fair2.ai/shapes/",
    "fair2": "https://fair2.ai/ns/"
  },
  "@graph": [
    {
      "@id": "fair2s:ContributionShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "schema:Contribution",
      "sh:property": [
        {
          "sh:path": "prov:agent",
          "sh:nodeKind": "sh:BlankNodeOrIRI",
          "sh:minCount": 1,
          "sh:message": "Each contribution must reference at least one agent (Person or Organization)."
        },
        {
          "sh:path": "prov:hadRole",
          "sh:node": { "@id": "fair2s:ContributorRoleShape" },
          "sh:minCount": 1,
          "sh:message": "Each contribution must include at least one role."
        }
      ]
    },
    {
      "@id": "fair2s:ContributorRoleShape",
      "@type": "sh:NodeShape",
      "sh:targetSubjectsOf": "prov:hadRole",
      "sh:property": [
        {
          "sh:path": "rdfs:label",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "Each role must have a human-readable label (e.g., DataCuration, Supervision)."
        }
      ]
    }
  ]
}