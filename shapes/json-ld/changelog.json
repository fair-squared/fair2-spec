{
    "@context": {
        "prov": "http://www.w3.org/ns/prov#",
        "schema": "https://schema.org/",
        "sh": "http://www.w3.org/ns/shacl#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "fair2": "https://fair2.ai/ns/",
        "fair2s": "https://fair2.ai/shapes/",
        "sh:path": {
            "@type": "@id"
        },
        "sh:node": {
            "@type": "@id"
        },
        "sh:targetClass": {
            "@type": "@id"
        },
        "sh:datatype": {
            "@type": "@id"
        }
    },
    "@graph": [
        {
            "@id": "fair2s:UpdateActionShape",
            "@type": "sh:NodeShape",
            "sh:property": [
                {
                    "sh:path": "schema:datePublished",
                    "sh:minCount": 1,
                    "sh:datatype": "xsd:date"
                },
                {
                    "sh:path": "schema:description",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape",
                    "sh:description": "A human-readable summary of the update. schema:description takes Text; the change categories below are siblings, not sub-properties of it."
                },
                {
                    "sh:path": "fair2:bugFixes",
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "fair2:improvements",
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "fair2:newFeatures",
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "fair2:otherInformation",
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "prov:wasRevisionOf",
                    "sh:node": "fair2s:VersionReferenceShape"
                }
            ],
            "sh:targetClass": "schema:UpdateAction"
        },
        {
            "@id": "fair2s:VersionReferenceShape",
            "@type": "sh:NodeShape",
            "sh:property": [
                {
                    "sh:path": "schema:identifier",
                    "sh:node": "fair2s:IdentifierShape"
                },
                {
                    "sh:path": "schema:version",
                    "sh:node": "fair2s:TextShape"
                }
            ]
        }
    ]
}
