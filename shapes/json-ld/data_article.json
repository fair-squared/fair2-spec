{
    "@context": {
        "prov": "http://www.w3.org/ns/prov#",
        "schema": "https://schema.org/",
        "sh": "http://www.w3.org/ns/shacl#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "fair2": "https://fair2.ai/ns/",
        "fair2s": "https://fair2.ai/shapes/",
        "sh:path": {
            "@type": "@id"
        },
        "sh:node": {
            "@type": "@id"
        },
        "sh:targetClass": {
            "@type": "@id"
        },
        "sh:nodeKind": {
            "@type": "@id"
        },
        "sh:or": {
            "@container": "@list"
        }
    },
    "@id": "fair2s:ArticleShape",
    "@type": "sh:NodeShape",
    "sh:nodeKind": "sh:IRI",
    "sh:or": [
        {
            "sh:property": [
                {
                    "sh:path": "schema:headline",
                    "sh:minCount": 1
                }
            ]
        },
        {
            "sh:property": [
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1
                }
            ]
        }
    ],
    "sh:property": [
        {
            "sh:path": "prov:wasDerivedFrom",
            "sh:minCount": 1,
            "sh:node": "fair2s:IdentifierShape"
        },
        {
            "sh:path": "schema:version",
            "sh:minCount": 1,
            "sh:node": "fair2s:TextShape"
        },
        {
            "sh:path": "schema:datePublished",
            "sh:minCount": 1
        },
        {
            "sh:path": "schema:publisher",
            "sh:minCount": 1
        },
        {
            "sh:path": "fair2:changeLog",
            "sh:node": "fair2s:UpdateActionShape"
        }
    ],
    "sh:targetClass": "schema:ScholarlyArticle"
}
