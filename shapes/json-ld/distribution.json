{
    "@context": {
        "schema": "https://schema.org/",
        "sh": "http://www.w3.org/ns/shacl#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "cr": "http://mlcommons.org/croissant/",
        "fair2s": "https://fair2.ai/shapes/",
        "fair2": "https://fair2.ai/ns/",
        "sh:path": {
            "@type": "@id"
        },
        "sh:node": {
            "@type": "@id"
        },
        "sh:targetClass": {
            "@type": "@id"
        },
        "sh:nodeKind": {
            "@type": "@id"
        },
        "sh:datatype": {
            "@type": "@id"
        }
    },
    "@graph": [
        {
            "@id": "fair2s:DistributionShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:IRI",
            "sh:property": [
                {
                    "sh:path": "fair2:encrypted",
                    "sh:maxCount": 1,
                    "sh:datatype": "xsd:boolean"
                },
                {
                    "sh:path": "schema:contentUrl",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:IdentifierShape"
                },
                {
                    "sh:path": "schema:contentSize",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "schema:encodingFormat",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "schema:sha256",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                }
            ],
            "sh:targetClass": "cr:FileObject"
        },
        {
            "@id": "fair2s:FileSetShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:IRI",
            "sh:property": [
                {
                    "sh:path": "fair2:encrypted",
                    "sh:maxCount": 1,
                    "sh:datatype": "xsd:boolean"
                },
                {
                    "sh:path": "cr:includes",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape",
                    "sh:description": "A glob pattern selecting the files to include."
                },
                {
                    "sh:path": "cr:containedIn",
                    "sh:nodeKind": "sh:IRI",
                    "sh:description": "The archive or manifest the files come from, by its @id."
                },
                {
                    "sh:path": "schema:encodingFormat",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "cr:excludes",
                    "sh:node": "fair2s:TextShape"
                }
            ],
            "sh:targetClass": "cr:FileSet"
        }
    ]
}
