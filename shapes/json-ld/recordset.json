{
    "@context": {
        "schema": "https://schema.org/",
        "sh": "http://www.w3.org/ns/shacl#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "cr": "http://mlcommons.org/croissant/",
        "fair2s": "https://fair2.ai/shapes/",
        "fair2": "https://fair2.ai/ns/",
        "sh:path": {
            "@type": "@id"
        },
        "sh:node": {
            "@type": "@id"
        },
        "sh:targetClass": {
            "@type": "@id"
        },
        "sh:nodeKind": {
            "@type": "@id"
        },
        "sh:targetObjectsOf": {
            "@type": "@id"
        }
    },
    "@graph": [
        {
            "@id": "fair2s:AnnotationShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:IRI",
            "sh:description": "A statistic or other annotation on a RecordSet or Field, per Croissant's annotation mechanism. It carries a value instead of a source.",
            "sh:property": [
                {
                    "sh:path": "cr:dataType",
                    "sh:maxCount": 1,
                    "sh:nodeKind": "sh:IRI",
                    "sh:description": "Optional: the kind of statistic, as a resolvable term. A controlled vocabulary for these is not yet settled."
                },
                {
                    "sh:path": "schema:value",
                    "sh:minCount": 1,
                    "sh:maxCount": 1,
                    "sh:description": "The value. Its datatype varies by statistic, so none is imposed."
                },
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape",
                    "sh:description": "What the annotation reports, e.g. mean or missing_values."
                }
            ],
            "sh:targetObjectsOf": "cr:annotation"
        },
        {
            "@id": "fair2s:FieldShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:IRI",
            "sh:property": [
                {
                    "sh:path": "cr:source",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:SourceShape",
                    "sh:description": "The mapping to the physical file and column."
                },
                {
                    "sh:path": "cr:dataType",
                    "sh:minCount": 1,
                    "sh:nodeKind": "sh:IRI",
                    "sh:description": "The semantic type of the data (e.g., schema:Float)."
                },
                {
                    "sh:path": "fair2:role",
                    "sh:maxCount": 1,
                    "sh:pattern": "^(identifier|dimension|measure|count|category|datetime|geo|filemeta)$"
                },
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape",
                    "sh:message": "Name must be a string or a language-tagged string."
                },
                {
                    "sh:path": "schema:description",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                }
            ],
            "sh:targetObjectsOf": "cr:field"
        },
        {
            "@id": "fair2s:RecordSetShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:IRI",
            "sh:property": [
                {
                    "sh:path": "cr:field",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:FieldShape",
                    "sh:description": "The columns/attributes defined within this record set."
                },
                {
                    "sh:path": "fair2:unitPlural",
                    "sh:maxCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "fair2:unitSingular",
                    "sh:maxCount": 1,
                    "sh:node": "fair2s:TextShape"
                },
                {
                    "sh:path": "schema:name",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape",
                    "sh:message": "Name must be a string or a language-tagged string."
                },
                {
                    "sh:path": "schema:description",
                    "sh:minCount": 1,
                    "sh:node": "fair2s:TextShape"
                }
            ],
            "sh:targetClass": "cr:RecordSet"
        },
        {
            "@id": "fair2s:SourceShape",
            "@type": "sh:NodeShape",
            "sh:nodeKind": "sh:BlankNodeOrIRI",
            "sh:property": [
                {
                    "sh:path": "cr:fileObject",
                    "sh:minCount": 1,
                    "sh:nodeKind": "sh:IRI",
                    "sh:description": "The @id of the FileObject this field is extracted from."
                },
                {
                    "sh:path": "cr:extract",
                    "sh:node": {
                        "sh:property": [
                            {
                                "sh:path": "cr:column",
                                "sh:minCount": 1,
                                "sh:node": "fair2s:TextShape"
                            }
                        ]
                    },
                    "sh:description": "The physical column name in the source file."
                }
            ]
        }
    ]
}
