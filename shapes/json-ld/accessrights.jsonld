{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "fair2": "https://fair2.ai/ns/",
    "fair2s": "https://fair2.ai/shapes/"
  },
  "@graph": [
    {
      "@id": "fair2s:AccessRightsShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "schema:DefinedTerm",
      "sh:property": [
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "AccessRights must have a name (e.g., 'Open Access')."
        },
        {
          "sh:path": "skos:definition",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:message": "AccessRights must provide a definition describing the access conditions."
        },
        {
          "sh:path": "skos:note",
          "sh:datatype": "xsd:string",
          "sh:message": "AccessRights may include a note clarifying additional access information."
        },
        {
          "sh:path": "schema:url",
          "sh:nodeKind": "sh:IRI",
          "sh:pattern": "https://fair2.ai/spec/AgreementLevels/",
          "sh:message": "AccessRights URL must point to a FAIR² Agreement Level definition (1–4)."
        },
        {
          "sh:path": "@id",
          "sh:nodeKind": "sh:IRI",
          "sh:pattern": "https://fair2.ai/ns/AgreementLevels",
          "sh:message": "AccessRights @id should be a FAIR² AgreementLevels URI."
        }
      ]
    }
  ]
}