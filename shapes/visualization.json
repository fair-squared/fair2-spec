{
    "@context": {
        "sh": "http://www.w3.org/ns/shacl#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "https://schema.org/"
    },
    "@id": "http://senscience.ai/VisualizationShape",
    "@type": "NodeShape",
    "targetClass": "fair2s:Visualization",
    "property": [
        {
            "path": "schema:name",
            "datatype": "xsd:string",
            "minCount": 1,
            "maxCount": 1
        },
        {
            "path": "schema:description",
            "minCount": 1,
            "maxCount": 1
        },
        {
            "path": "fair2:active",
            "datatype": "xsd:boolean",
            "minCount": 1,
            "maxCount": 1
        },
        {
            "path": "fair2:model",
            "datatype": "xsd:string",
            "schema:description": "The model used to generate the visualization, given as @json",
            "minCount": 1,
            "maxCount": 1
        },
        {
            "path": "fair2:schema",
            "datatype": "xsd:string",
            "schema:description": "The schema used to generate the visualization, given as @json",
            "minCount": 1,
            "maxCount": 1
        }
    ]
}