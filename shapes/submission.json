{
  "@context": "https://fair2.ai/spec/context.json",
  "@id": "f2:SubmissionShape",
  "@type": "NodeShape",
  "property": [
    {
      "minCount": 2,
      "or": [
        {
          "class": "https://schema.org/CreativeWork"
        },
        {
          "class": "https://schema.org/ScholarlyArticle"
        },
        {
          "class": "https://schema.org/Dataset",
          "node": {
            "@type": "NodeShape",
            "property": [
              {
                "minCount": 1,
                "path": "https://schema.org/distribution"
              },
              {
                "minCount": 1,
                "path": "cr:recordSet"
              }
            ]
          }
        }
      ],
      "path": "https://schema.org/isBasedOn"
    }
  ],
  "targetClass": "f2:Submission"
}