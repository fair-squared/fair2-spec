{
    "@context": {
        "sh": "http://www.w3.org/ns/shacl#",
        "schema": "http://schema.org/",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@id": "schema:GrantShape",
    "@type": "sh:NodeShape",
    "targetClass": "schema:Grant",
    "property": [
        {
            "path": "schema:identifier",
            "datatype": "xsd:string"
        },
        {
            "path": "schema:name",
            "datatype": "xsd:string",
            "minCount": 1
        },
        {
            "path": "schema:description",
            "datatype": "xsd:string"
        },
        {
            "path": "schema:fundingAgency",
            "node": {
                "nodeKind": "sh:IRI"
            }
        },
        {
            "path": "schema:amount",
            "datatype": "xsd:decimal"
        }
    ]
}