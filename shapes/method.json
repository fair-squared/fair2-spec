{
  "@context": "https://fair-squared.github.io/fair2-spec/context/fair2_context.json", 
  "@graph": [
    {
      "@id": "f2:MethodSectionShape",
      "@type": "NodeShape",
      "property": [
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/name"
        },
        {
          "minCount": 1,
          "nodeKind": "sh:IRI",
          "path": "f2:step"
        }
      ],
      "targetClass": "f2:Section"
    },
    {
      "@id": "f2:MethodStepShape",
      "@type": "NodeShape",
      "property": [
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/name"
        },
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/description"
        }
      ],
      "targetClass": "f2:Step"
    }
  ]
}
