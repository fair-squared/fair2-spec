{
  "@context": [
    "https://fair2.ai/spec/fair2_context",
    "https://fair2.ai/spec/shacl_context"
  ],
  "shapes": [
    {
      "@id": "fair2s:MethodShape",
      "@type": "NodeShape",
      "property": [
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/name"
        },
        {
          "minCount": 1,
          "nodeKind": "sh:IRI",
          "path": "fair2:methodSection"
        }
      ],
      "targetClass": "fair2:Method"
    },
    {
      "@id": "fair2s:MethodSectionShape",
      "@type": "NodeShape",
      "property": [
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/name"
        },
        {
          "minCount": 1,
          "nodeKind": "sh:IRI",
          "path": "fair2:step"
        }
      ],
      "targetClass": "fair2:MethodSection"
    },
    {
      "@id": "fair2s:MethodStepShape",
      "@type": "NodeShape",
      "property": [
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/name"
        },
        {
          "datatype": "xsd:string",
          "path": "https://schema.org/description"
        },
        {
          "path": "schema:nextItem",
          "nodeKind": "sh:IRI"
        },
        {
          "path": "substep",
          "nodeKind": "sh:IRI",
          "targetClass": "fair2:Step"
        }
      ],
      "targetClass": "fair2:Step"
    }
  ]
}
