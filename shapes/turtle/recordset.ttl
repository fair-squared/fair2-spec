@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr: <http://mlcommons.org/croissant/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

fair2s:RecordSetShape
    a sh:NodeShape ;
    sh:targetClass cr:RecordSet ;
    sh:nodeKind sh:IRI ;

    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
        sh:message "Name must be a string or a language-tagged string."
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape
    ] ;

    sh:property [
        sh:path cr:field ;
        sh:minCount 1 ;
        sh:node fair2s:FieldShape ;
        sh:description "The columns/attributes defined within this record set."
    ] ;
    sh:property [
        sh:path fair2:unitSingular ;
        sh:maxCount 1 ;
        sh:node fair2s:TextShape ;
    ] ;
    sh:property [
        sh:path fair2:unitPlural ;
        sh:maxCount 1 ;
        sh:node fair2s:TextShape ;
    ] .

# Targets the objects of cr:field, not every cr:Field. A statistic is also a
# cr:Field - Croissant models statistics as cr:annotation entries - but it
# carries a value rather than a source, so the data-field requirements below
# must not reach it. fair2s:AnnotationShape covers those instead.
fair2s:FieldShape
    a sh:NodeShape ;
    sh:targetObjectsOf cr:field ;
    sh:nodeKind sh:IRI ;

    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
        sh:message "Name must be a string or a language-tagged string."
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape
    ] ;
    sh:property [
        sh:path cr:dataType ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description "The semantic type of the data (e.g., schema:Float)."
    ] ;
    # A pattern rather than sh:in: the context's @language makes these strings
    # language-tagged, which sh:in would compare as different terms.
    sh:property [
        sh:path fair2:role ;
        sh:maxCount 1 ;
        sh:pattern "^(identifier|dimension|measure|count|category|datetime|geo|filemeta)$" ;
    ] ;

    sh:property [
        sh:path cr:source ;
        sh:minCount 1 ;
        sh:node fair2s:SourceShape ;
        sh:description "The mapping to the physical file and column."
    ] .

# A field's unit is a node of its own, referenced by IRI: a QUDT unit, or any
# other where QUDT has none. When it is described, it has a label and a
# symbol, usually given once under `included`. Units carry no @type, so the shape
# targets what fair2:unit points at. Neither label nor symbol is required: a
# unit may be given by its IRI alone.
fair2s:UnitShape
    a sh:NodeShape ;
    sh:targetObjectsOf fair2:unit ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path rdfs:label ;
        sh:node fair2s:TextShape ;
        sh:description "The unit's name, e.g. \"Micrograms per litre\"."
    ] ;
    sh:property [
        sh:path qudt:symbol ;
        sh:node fair2s:TextShape ;
        sh:description "The unit's symbol, e.g. \"µg/L\"."
    ] .

# Croissant takes a field's values from a FileObject or from a FileSet - a
# sharded table, or a column of paths to shipped files. Until v1.6.2 only
# cr:fileObject was accepted, so every field sourced from a FileSet failed.
fair2s:SourceShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;

    sh:or (
        [ sh:property [ sh:path cr:fileObject ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path cr:fileSet ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    ) ;
    sh:message "A field's source must name the FileObject or FileSet its values come from." ;

    sh:property [
        sh:path cr:fileObject ;
        sh:nodeKind sh:IRI ;
        sh:description "The @id of the FileObject this field is extracted from."
    ] ;

    sh:property [
        sh:path cr:fileSet ;
        sh:nodeKind sh:IRI ;
        sh:description "The @id of the FileSet this field is extracted from."
    ] ;

    sh:property [
        sh:path cr:extract ;
        sh:node [
            sh:property [ sh:path cr:column ; sh:minCount 1 ; sh:node fair2s:TextShape ]
        ] ;
        sh:description "The physical column name in the source file."
    ] .

# A verified multi-column foreign key, when the target's cr:key is already
# another set of fields (otherwise it is written the Croissant way: a
# cr:references per field into the target's key). One field per key column on
# each side.
fair2s:CompositeKeyShape
    a sh:NodeShape ;
    sh:targetClass fair2:CompositeKey ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path fair2:fromField ;
        sh:minCount 2 ;
        sh:nodeKind sh:IRI ;
        sh:message "A composite key names at least two source fields."
    ] ;
    sh:property [
        sh:path fair2:toField ;
        sh:minCount 2 ;
        sh:nodeKind sh:IRI ;
        sh:message "A composite key names at least two target fields."
    ] .

fair2s:AnnotationShape
    a sh:NodeShape ;
    sh:targetObjectsOf cr:annotation ;
    sh:nodeKind sh:IRI ;
    sh:description "A statistic or other annotation on a RecordSet or Field, per Croissant's annotation mechanism. It carries a value instead of a source." ;

    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
        sh:description "What the annotation reports, e.g. mean or missing_values."
    ] ;
    sh:property [
        sh:path schema:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "The value. Its datatype varies by statistic, so none is imposed."
    ] ;
    sh:property [
        sh:path cr:dataType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description "Optional: the kind of statistic, as a resolvable term. A controlled vocabulary for these is not yet settled."
    ] .
