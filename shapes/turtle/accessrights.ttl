@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:AccessRightsShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "AccessRights must have a name (e.g., 'Open Access')." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "AccessRights URL must point to a FAIR² Agreement Level definition (1–4)." ;
            sh:nodeKind sh:IRI ;
            sh:path schema:url ;
            sh:pattern "https://fair2.ai/spec/AgreementLevels/" ],
        [ sh:datatype xsd:string ;
            sh:message "AccessRights must provide a definition describing the access conditions." ;
            sh:minCount 1 ;
            sh:path skos:definition ],
        [ sh:datatype xsd:string ;
            sh:message "AccessRights may include a note clarifying additional access information." ;
            sh:path skos:note ] ;
    sh:targetClass schema:DefinedTerm .

