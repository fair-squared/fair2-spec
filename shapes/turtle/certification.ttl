@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

fair2s:CertificationShape
    a sh:NodeShape ;
    sh:targetClass fair2:Certification ;

    sh:property [
        sh:path fair2:certifiedBy ;
        sh:minCount 1 ;
        sh:node fair2s:OrganizationShape ;
    ] ;

    sh:property [
        sh:path fair2:dateIssued ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
    ] ;

    sh:property [
        sh:path fair2:fair2ComplianceLevel ;
        sh:minCount 1 ;
        sh:node fair2s:IdentifierShape ;
    ] ;

    sh:property [
        sh:path fair2:certificationDocument ;
        sh:minCount 1 ;
        sh:node fair2s:IdentifierShape ;
    ] ;

    sh:property [
        sh:path fair2:verificationEndpoint ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:path fair2:certificationScope ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
    ] ;

    # What was checked, by what, and where the evidence is. Optional for now:
    # requiring them would invalidate every certification issued to date.
    sh:property [
        sh:path dct:conformsTo ;
        sh:nodeKind sh:IRI ;
        sh:description "The FAIR2 spec or profile version validated against, as a resolvable https://fair2.ai/spec/vX.Y.Z URI."
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:node fair2s:ActivityShape ;
        sh:description "The validation run, carrying the validator as a prov:SoftwareAgent with its version - the same pattern used for descriptive statistics."
    ] ;
    sh:property [
        sh:path fair2:validationReport ;
        sh:node fair2s:IdentifierShape ;
        sh:description "The validation report backing the claim."
    ] .
