@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:DataArticleShape a sh:NodeShape ;
    sh:property [ sh:message "Data article must specify a publisher organization." ;
            sh:minCount 1 ;
            sh:node fair2s:PublisherShape ;
            sh:path schema:publisher ],
        [ sh:datatype xsd:date ;
            sh:message "Data article must have a publication date." ;
            sh:minCount 1 ;
            sh:path schema:datePublished ],
        [ sh:datatype xsd:string ;
            sh:message "Data article must include a title." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Data article must reference a publication (journal or periodical)." ;
            sh:minCount 1 ;
            sh:node fair2s:PublicationShape ;
            sh:path schema:publication ],
        [ sh:message "Data article must reference the dataset DOI or persistent identifier." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass schema:ScholarlyArticle .

fair2s:PublicationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Publication must include a name (journal or periodical title)." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:Periodical .

fair2s:PublisherShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Publisher organization must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:Organization .

