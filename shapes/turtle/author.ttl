@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:AuthorShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Each author must have a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Each author must include an identifier, preferably an ORCID." ;
            sh:minCount 1 ;
            sh:path schema:identifier ],
        [ sh:message "Each author must be affiliated with at least one organization." ;
            sh:minCount 1 ;
            sh:node fair2s:OrganizationShape ;
            sh:path schema:affiliation ] ;
    sh:targetClass schema:Person .

fair2s:OrganizationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Organization must have a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Organization should include a persistent identifier (e.g., ROR)." ;
            sh:minCount 1 ;
            sh:path schema:identifier ],
        [ sh:datatype xsd:string ;
            sh:message "Organization should include a postal address." ;
            sh:minCount 1 ;
            sh:path schema:address ] ;
    sh:targetClass schema:Organization .

