@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix cr: <https://mlcommons.org/croissant/> .
@prefix cr1: <http://mlcommons.org/croissant/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cr:DatasetShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "A dataset must have a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "A dataset must have at least one distribution." ;
            sh:minCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:message "Each distribution must have a SHA-256 checksum." ;
                            sh:minCount 1 ;
                            sh:path cr1:sha256 ],
                        [ sh:datatype xsd:string ;
                            sh:message "Each distribution must specify its encoding format." ;
                            sh:minCount 1 ;
                            sh:path schema:encodingFormat ],
                        [ sh:datatype xsd:anyURI ;
                            sh:message "Each distribution must have a content URL." ;
                            sh:minCount 1 ;
                            sh:path schema:contentUrl ] ] ;
            sh:path cr1:distribution ],
        [ sh:datatype xsd:anyURI ;
            sh:message "A dataset must have a license." ;
            sh:minCount 1 ;
            sh:path schema:license ],
        [ sh:datatype xsd:string ;
            sh:message "A dataset must have a description." ;
            sh:minCount 1 ;
            sh:path schema:description ],
        [ sh:datatype xsd:anyURI ;
            sh:message "A dataset must have a URL." ;
            sh:minCount 1 ;
            sh:path schema:url ],
        [ sh:message "A dataset must have at least one record set." ;
            sh:minCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:message "Each record set must have a name." ;
                            sh:minCount 1 ;
                            sh:path schema:name ],
                        [ sh:message "Each record set must have at least one field." ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:message "Each field must have a name." ;
                                            sh:minCount 1 ;
                                            sh:path schema:name ],
                                        [ sh:datatype xsd:string ;
                                            sh:message "Each field must specify a data type." ;
                                            sh:minCount 1 ;
                                            sh:path schema:dataType ],
                                        [ sh:datatype xsd:string ;
                                            sh:message "Each field must have a description." ;
                                            sh:minCount 1 ;
                                            sh:path schema:description ] ] ;
                            sh:path cr1:field ] ] ;
            sh:path cr1:recordSet ] ;
    sh:targetClass cr1:Dataset .

