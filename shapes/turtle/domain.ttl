@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:DomainShape a sh:NodeShape ;
    sh:property [ sh:message "Each domain should be attributed to at least one Person (creator or expert)." ;
            sh:minCount 1 ;
            sh:node fair2s:AuthorShape ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:message "Each domain entry must include a name (e.g., 'Marine Biology')." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:Thing .

