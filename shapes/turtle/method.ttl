@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2: <https://fair2.ai/ns/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:MethodShape a sh:NodeShape ;
    sh:property [ sh:message "Each MethodSection must contain at least one Step." ;
            sh:minCount 1 ;
            sh:node fair2s:StepShape ;
            sh:path fair2:step ],
        [ sh:datatype xsd:string ;
            sh:message "Each MethodSection must include a section name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:datatype xsd:string ;
            sh:message "Each MethodSection may include a description summarizing the methodological context." ;
            sh:path schema:description ] ;
    sh:targetClass fair2:MethodSection .

fair2s:StepShape a sh:NodeShape ;
    sh:property [ sh:message "If provided, 'next' should reference the following step using an IRI." ;
            sh:nodeKind sh:IRI ;
            sh:path fair2:next ],
        [ sh:message "If provided, 'generated' should reference produced data elements (e.g., fields, recordSets)." ;
            sh:nodeKind sh:IRI ;
            sh:path fair2:generated ],
        [ sh:datatype xsd:string ;
            sh:message "Each Step may include a description detailing actions or parameters." ;
            sh:path schema:description ],
        [ sh:datatype xsd:string ;
            sh:message "Each Step must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Substeps may be defined as nested procedural components." ;
            sh:node fair2s:SubStepShape ;
            sh:path fair2:substep ] ;
    sh:targetClass fair2:Step .

fair2s:SubStepShape a sh:NodeShape ;
    sh:property [ sh:message "If provided, 'next' should reference the subsequent substep." ;
            sh:nodeKind sh:IRI ;
            sh:path fair2:next ],
        [ sh:datatype xsd:string ;
            sh:message "Each Substep must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:datatype xsd:string ;
            sh:message "Each Substep may include a descriptive text." ;
            sh:path schema:description ] ;
    sh:targetClass fair2:Substep .

