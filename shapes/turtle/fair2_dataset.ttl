@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

fair2s:DatasetShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Dataset may specify the temporal coverage (e.g., 1995–2023)." ;
            sh:path schema:temporalCoverage ],
        [ sh:datatype xsd:date ;
            sh:message "Dataset may include its creation date." ;
            sh:path schema:dateCreated ],
        [ sh:message "Dataset may include social media dissemination metadata." ;
            sh:node fair2s:SocialMediaShape ;
            sh:path fair2:socialMedia ],
        [ sh:message "Dataset must include at least one author." ;
            sh:minCount 1 ;
            sh:node fair2s:AuthorShape ;
            sh:path schema:author ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must include at least one keyword." ;
            sh:minCount 1 ;
            sh:path schema:keywords ],
        [ sh:datatype xsd:date ;
            sh:message "Dataset may include its last updated date." ;
            sh:path schema:dateUpdated ],
        [ sh:datatype xsd:date ;
            sh:message "Dataset may include its publication date." ;
            sh:path schema:datePublished ],
        [ sh:message "Dataset must include contributor metadata and roles." ;
            sh:minCount 1 ;
            sh:node fair2s:ContributionShape ;
            sh:path schema:contribution ],
        [ sh:message "Dataset may specify spatial coverage information." ;
            sh:node fair2s:SpatialCoverageShape ;
            sh:path schema:spatialCoverage ],
        [ sh:message "Dataset may include a structured changelog for version history." ;
            sh:node fair2s:ChangeLogShape ;
            sh:path fair2:changeLog ],
        [ sh:message "Dataset must include at least one MethodSection describing methodology." ;
            sh:minCount 1 ;
            sh:node fair2s:MethodShape ;
            sh:path fair2:method ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must include a description." ;
            sh:minCount 1 ;
            sh:path schema:description ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must provide a citationKey for internal referencing." ;
            sh:minCount 1 ;
            sh:path schema:citationKey ],
        [ sh:message "Dataset must include a citation to the related Data Article." ;
            sh:minCount 1 ;
            sh:node fair2s:DataArticleShape ;
            sh:path schema:citation ],
        [ sh:message "Dataset must declare an open license IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema:license ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Dataset may include a content URL for direct access." ;
            sh:nodeKind sh:IRI ;
            sh:path schema:contentUrl ],
        [ sh:message "Dataset may include one or more funding entries." ;
            sh:node fair2s:FundingShape ;
            sh:path schema:funder ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must include a unique identifier (e.g., DOI)." ;
            sh:minCount 1 ;
            sh:path schema:identifier ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must include a full 'cite as' text citation." ;
            sh:minCount 1 ;
            sh:path fair2:citeAs ],
        [ sh:message "Dataset must specify access rights (e.g., FAIR² Agreement Level)." ;
            sh:minCount 1 ;
            sh:node fair2s:AccessRightsShape ;
            sh:path dct:accessRights ],
        [ sh:message "Dataset must declare at least one domain or subject area." ;
            sh:minCount 1 ;
            sh:node fair2s:DomainShape ;
            sh:path schema:subjectOf ],
        [ sh:datatype xsd:string ;
            sh:message "Dataset must specify its version." ;
            sh:minCount 1 ;
            sh:path schema:version ],
        [ sh:message "Dataset must include at least one RecordSet definition." ;
            sh:minCount 1 ;
            sh:node fair2s:RecordSetShape ;
            sh:path fair2:recordSet ] ;
    sh:targetClass schema:Dataset ;
    sh:targetObjectsOf rdf:type ;
    sh:targetSubjectsOf rdf:type .

fair2s:SpatialCoverageShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Spatial coverage must include a place name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Spatial coverage may include a geo reference." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path schema:geo ] ;
    sh:targetClass schema:Place .

