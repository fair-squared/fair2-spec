@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2:  <https://fair2.ai/ns/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix cr:     <http://mlcommons.org/croissant/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:FundingShape a sh:NodeShape ;
    sh:property [ sh:message "Each funding entry must specify at least one funder organization." ;
            sh:minCount 1 ;
            sh:node fair2s:FundingOrganizationShape ;
            sh:path schema:funder ],
        [ sh:datatype xsd:string ;
            sh:message "Each funding entry must include a grant name or title." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:maxCount 1 ;
            sh:message "If provided, fundingScheme must contain valid scheme metadata." ;
            sh:node fair2s:FundingSchemeShape ;
            sh:path schema:fundingScheme ],
        [ sh:maxCount 1 ;
            sh:message "Funding entries may optionally include a URL (e.g., project page)." ;
            sh:nodeKind sh:IRI ;
            sh:path schema:url ] ;
    sh:targetClass schema:Grant .

fair2s:FundingOrganizationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Funding organization must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ],
        [ sh:message "Funding organization should include an identifier (e.g., ROR ID)." ;
            sh:minCount 1 ;
            sh:path schema:identifier ] ;
    sh:targetClass schema:Organization .

fair2s:FundingSchemeShape a sh:NodeShape ;
    sh:property [ sh:message "Funding scheme must include an identifier (e.g., Horizon Europe code)." ;
            sh:minCount 1 ;
            sh:path schema:identifier ],
        [ sh:datatype xsd:string ;
            sh:message "Funding scheme must include a name." ;
            sh:minCount 1 ;
            sh:path schema:name ] ;
    sh:targetClass schema:FundingScheme .

