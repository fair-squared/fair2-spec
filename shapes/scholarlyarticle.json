{
    "@context": [
        "https://fair2.ai/spec/shacl_context",
        {
            "schema": "http://schema.org/",
            "xsd": "http://www.w3.org/2001/XMLSchema#"
        }
    ],
    "shapes": [
        {
            "@id": "http://example.org/shapes/ScholarlyArticleShape",
            "@type": "sh:NodeShape",
            "targetClass": "schema:ScholarlyArticle",
            "property": [
                {
                    "path": "schema:headline",
                    "datatype": "xsd:string"
                },
                {
                    "sh:path": "schema:name",
                    "sh:datatype": "xsd:string",
                    "sh:minCount": 1,
                    "sh:description": "The title of the article."
                },
                {
                    "sh:path": "schema:author",
                    "sh:node": "ex:AuthorShape",
                    "sh:minCount": 1,
                    "sh:description": "Authors of the article."
                },
                {
                    "sh:path": "schema:datePublished",
                    "sh:datatype": "xsd:date",
                    "sh:minCount": 1,
                    "sh:description": "The publication date of the article."
                },
                {
                    "sh:path": "schema:identifier",
                    "sh:pattern": "^10\\.\\d{4,9}/[-._;()/:A-Z0-9]+$",
                    "sh:message": "The article must have a valid DOI identifier."
                },
                {
                    "sh:path": "schema:abstract",
                    "sh:datatype": "xsd:string",
                    "sh:minCount": 1,
                    "sh:description": "The abstract summarizing the article."
                },
                {
                    "sh:path": "schema:keywords",
                    "sh:datatype": "xsd:string",
                    "sh:minCount": 1,
                    "sh:description": "Keywords associated with the article."
                },
                {
                    "sh:path": "schema:publisher",
                    "sh:node": "ex:PublisherShape",
                    "sh:description": "The publisher of the article."
                },
                {
                    "sh:path": "schema:articleSection",
                    "sh:node": "ex:SectionShape",
                    "sh:minCount": 1,
                    "sh:description": "The sections within the article."
                },
                {
                    "sh:path": "schema:citation",
                    "sh:node": "ex:ReferenceShape",
                    "sh:description": "References cited in the article."
                },
                {
                    "sh:path": "schema:figure",
                    "sh:node": "ex:FigureShape",
                    "sh:description": "Figures included in the article."
                },
                {
                    "sh:path": "schema:table",
                    "sh:node": "ex:TableShape",
                    "sh:description": "Tables included in the article."
                },
                {
                    "sh:path": "prov:wasDerivedFrom",
                    "sh:node": "ex:ProvenanceShape",
                    "sh:description": "Provenance information about data sources in the article."
                },
                {
                    "path": "schema:isPartOf",
                    "node": "http://example.org/shapes/PublicationIssueShape"
                }
            ]
        },
        {
            "@id": "http://example.org/shapes/PublicationIssueShape",
            "@type": "sh:NodeShape",
            "targetClass": "schema:PublicationIssue",
            "property": [
                {
                    "path": "schema:issueNumber",
                    "datatype": "xsd:string"
                },
                {
                    "path": "schema:isPartOf",
                    "node": "http://example.org/shapes/PublicationVolumeShape"
                }
            ]
        },
        {
            "@id": "http://example.org/shapes/PublicationVolumeShape",
            "@type": "sh:NodeShape",
            "targetClass": "schema:PublicationVolume",
            "property": [
                {
                    "path": "schema:volumeNumber",
                    "datatype": "xsd:string"
                },
                {
                    "path": "schema:isPartOf",
                    "node": "http://example.org/shapes/PeriodicalShape"
                }
            ]
        },
        {
            "@id": "http://example.org/shapes/PeriodocalShape",
            "@type": "sh:NodeShape",
            "targetClass": "schema:Periodical",
            "property": [
                {
                    "path": "schema:name",
                    "datatype": "xsd:string"
                },
                {
                    "path": "schema:issn",
                    "datatype": "xsd:string"
                },
                {
                    "path": "schema:publisher",
                    "node": {
                        "nodeKind": "sh:BlankNodeOrIRI",
                        "property": [
                            {
                                "path": "schema:name",
                                "datatype": "xsd:string"
                            },
                            {
                                "path": "schema:url",
                                "datatype": "xsd:anyURI"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}