{
  "@context": [
    "https://fair2.ai/spec/fair2_context",
    "https://fair2.ai/spec/shacl_context"
  ],
  "@id": "fair2:DatasetShape",
  "@type": "NodeShape",
  "targetClass": "Dataset",
  "imports": [
    "https://fair2.ai/shapes/AuthorShape",
    "https://fair2.ai/shapes/OrganizationShape",
    "https://fair2.ai/shapes/RecordSetShape",
    "https://fair2.ai/shapes/DataArticleShape",
    "https:schema.org/GrantShape"
  ],
  "property": [
    {
      "path": "schema:author",
      "node": "fair2s:AuthorShape",
      "minCount": 1,
      "description": "The author of the dataset."
    },
    {
      "path": "schema:citation",
      "datatype": "xsd:string",
      "minCount": 1,
      "description": "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc."
    },
    {
      "path": "cr:citeAs",
      "datatype": "xsd:string",
      "minCount": 1,
      "maxCount": 1,
      "description": "The preferred way to cite this dataset."
    },
    {
      "path": "schema:conformsTo",
      "datatype": "xsd:anyURI",
      "minCount": 1,
      "maxCount": 1,
      "description": "An established standard to which the dataset conforms."
    },
    {
      "path": "schema:contentUrl",
      "datatype": "xsd:anyURI",
      "minCount": 1,
      "description": "A URL to the actual dataset file."
    },
    {
      "path": "schema:datePublished",
      "datatype": "xsd:date",
      "minCount": 1,
      "maxCount": 1,
      "description": "The date on which the dataset was published."
    },
    {
      "path": "schema:description",
      "datatype": "xsd:string",
      "minCount": 1,
      "maxCount": 1,
      "description": "A description of the dataset."
    },
    {
      "path": "schema:distribution",
      "node": {
        "@type": "NodeShape",
        "property": [
          {
            "path": "schema:contentSize",
            "datatype": "xsd:integer",
            "description": "The size of the dataset file in bytes."
          },
          {
            "path": "schema:contentUrl",
            "datatype": "xsd:anyURI",
            "description": "A URL to the dataset file."
          },
          {
            "path": "schema:description",
            "datatype": "xsd:string",
            "description": "A description of the dataset file."
          },
          {
            "path": "schema:encodingFormat",
            "datatype": "xsd:string",
            "description": "The file format of the dataset file."
          },
          {
            "path": "schema:name",
            "datatype": "xsd:string",
            "description": "The name of the dataset file."
          },
          {
            "path": "cr:sha256",
            "datatype": "xsd:string",
            "description": "The SHA-256 hash of the dataset file."
          }
        ],
        "minCount": 1,
        "description": "Details about the distribution of the dataset."
      }
    },
    {
      "path": "schema:funding",
      "node": "schema:GrantShape",
      "minCount": 1
    },
    {
      "path": "schema:identifier",
      "datatype": "xsd:anyURI",
      "minCount": 1,
      "description": "A unique identifier for the dataset."
    },
    {
      "path": "schema:keywords",
      "datatype": "xsd:string",
      "minCount": 1,
      "description": "Keywords or tags used to describe the dataset."
    },
    {
      "path": "schema:license",
      "datatype": "xsd:anyURI",
      "minCount": 1,
      "description": "The license under which the dataset is published."
    },
    {
      "path": "schema:name",
      "datatype": "xsd:string",
      "minCount": 1,
      "description": "The name of the dataset."
    },
    {
      "path": "fair2:dataArticle",
      "node": "fair2s:DataArticleShape",
      "description": "Holds the metadata of a related data article." 
    },
    {
      "path": "cr:recordSet",
      "node": "mls:RecordSetShape",
      "minCount": 1
    },
    {
      "path": "schema:version",
      "datatype": "xsd:string",
      "minCount": 1,
      "description": "The version of the dataset."
    },
    {
      "path": "schema:dateCreated",
      "datatype": "xsd:date",
      "minCount": 1,
      "maxCount": 1,
      "description": "The date on which the dataset was created."
    },
    {
      "path": "schema:dateModified",
      "datatype": "xsd:date",
      "minCount": 1,
      "maxCount": 1,
      "description": "The date on which the dataset was last modified."
    },
    {
      "path": "fair2:isLiveDataset",
      "datatype": "xsd:boolean",
      "minCount": 1,
      "maxCount": 1,
      "description": "Indicates whether the dataset is live."
    }
    ,
    {
      "path": "rai:ethicsReview",
      "node": {
        "@type": "NodeShape",
        "property": [
          {
        "path": "rai:reviewedBy",
        "datatype": "xsd:string",
        "description": "The entity that reviewed the dataset for ethical considerations."
          },
          {
        "path": "rai:approvalStatus",
        "datatype": "xsd:string",
        "description": "The approval status of the ethics review."
          },
          {
        "path": "rai:reviewDate",
        "datatype": "xsd:date",
        "description": "The date on which the ethics review was conducted."
          }
        ]
      },
      "datatype": "xsd:string",
      "description": "Information about the ethics review process for the dataset."
    },
    {
      "path": "rai:dataBiases",
      "datatype": "xsd:string",
      "description": "Information about any known biases in the dataset."
    },
    {
      "path": "rai:dataLimitations",
      "datatype": "xsd:string",
      "description": "Information about any limitations of the dataset."
    },
    {
      "path": "fair2:method",
      "node": "fair2s:MethodShape",
      "description": "The methods used to generate the dataset."
    }
  ]
}